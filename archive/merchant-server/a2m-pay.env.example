# a2m-pay.env 模板 —— 填好后 chmod 600，传到服务器 /home/ubuntu/a2m-pay/a2m-pay.env
# 获取途径：https://aipay.alipay.com/?from=alipay-aipay-skill 控制台 → 服务管理（真实 serviceId）
#          https://b.alipay.com/page/portal/home 头像下方 2088 开头 PID

# 生产应用配置（appId 2021 开头，与密钥同属一套生产应用）
AIPAY_APP_ID=
# 应用私钥（PKCS#1 原始字符串，不带 PEM 头尾）
AIPAY_PRIVATE_PKCS_KEY=
# 支付宝公钥
AIPAY_ALIPAY_PUBLIC_KEY=
# 商户 PID（2088 开头）
ALIPAY_SELLER_ID=
# 服务市场真实 serviceId（API_ 开头；严禁 api_mock_service_id 上生产）
ALIPAY_SERVICE_ID=
# 生产网关（ payment_server.py 默认值即生产网关，可不配；沙箱联调才显式改）
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 单次价格（必须与支付宝服务登记单价一致）
ALIPAY_PRICE=0.10
